# ============================================
# ShikshaSetu .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv/

# Environment Variables (CRITICAL - Never commit!)
.env
.env.local
.env.production
.env.*.local

# Secrets & Credentials (CRITICAL)
*password*
*secret*
*credentials.json
*.pem
*.key
id_rsa*

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Logs
logs/*.log
logs/*.pid
!logs/.gitkeep

# Runtime artifacts
*.pid
.env.local

# Database
*.db
*.sqlite
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Frontend Build
.vite/
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
# Lockfiles are committed. This is an application, not a library: pinning the
# exact dependency tree is what makes a build reproducible, and `npm ci`
# requires the lockfile to exist.

# Storage (Keep structure, not files)
storage/uploads/*
storage/cache/*
storage/audio/*
storage/captions/*
storage/models/*
!storage/**/.gitkeep

# Data Models (Large files - downloaded from HuggingFace)
data/models/models--*
data/models/*.bin
data/models/*.safetensors
*.bin
*.safetensors
*.ckpt
*.pt
*.pth

# Docker
docker-compose.override.yml
*.pid

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.pkl

# Alembic
alembic/versions/*.pyc

# Supabase
.supabase/
.projectx/

# Downloaded model weights / HF cache (regenerable, GBs)
data/models/
data/uploads/
# Stray runtime logs at repo root
*.log

# NCERT corpus: large and re-downloadable. The catalog JSON is kept.
data/ncert/

# LaTeX build artefacts. The .tex is the source of truth for the paper; a
# second rendered copy in the repo is a copy that can disagree with it.
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk


# Cached generations for the grounding benchmark. Re-creatable by rerunning it,
# and large enough that a diff of it is unreadable.
.grounding_cache*.json
