# Serving profile for a 4 GB machine.
#
# Measured peak resident set of the serving path is ~1.9 GB
# (scripts/benchmarks/serving_footprint.py). The budget that has to fit:
#
#     API process, first encode onward    ~1,900 MB   (mean of 6 runs)
#     Postgres shared_buffers               128 MB   (set below)
#     Postgres backends, ~4 x 8 MB           32 MB
#     OS and page cache                    ~400 MB
#                                       ───────────
#                                        ~2,460 MB of 4,096
#
# The headroom is what absorbs a second concurrent request, so the settings here
# are about holding the ceiling down rather than going faster.
#
#     cp deploy/4gb.env .env        # then set NVIDIA_API_KEY and JWT_SECRET_KEY
#
# What does NOT fit alongside this is ingestion. The embedder plus a 70 MB zip
# expanded across twenty PDFs needs the room the API is holding. Ingest on a
# larger machine and restore, or stop the API while ingesting -- the pipeline is
# resumable, so alternating costs only wall-clock.

# ---- the model ----------------------------------------------------------
# Half precision. 1,083 MB of weights instead of 2,166, at a measured cosine
# similarity of 0.999999 against float32. This is the single largest saving
# available and it costs nothing. Set explicitly because platform detection
# picks float32 when it lands on CPU.
EMBEDDING_DTYPE=float16

# One text per forward pass. Chosen on speed, which is what could actually be
# measured: encoding the 32 longest chunks in the corpus took 16 s at batch 1,
# 22 s at batch 8 and 27 s at batch 32, reproducible in both orders. Larger
# batches are slower here, not faster.
#
# Its effect on peak memory is unknown. Two passes in opposite orders gave
# 1516/1749/2817 MB and then 1661/2837/2697 MB for batches 1/8/32 -- the
# monotonic pattern in the first pass did not survive the second, so it was
# machine state, not batch size. Peak is dominated by the weights becoming
# resident, and the batch encode never raised it above what a single warm-up
# encode had already reached.
EMBEDDING_BATCH_SIZE=1

# Generation is a hosted call, so no LLM weights are resident. Running a local
# model on 4 GB alongside the embedder is not possible -- do not set
# LLM_BACKEND=local here.
LLM_BACKEND=nvidia

# ---- database -----------------------------------------------------------
# Postgres defaults to 128 MB shared_buffers on most packages; the usual advice
# to raise it to 25% of RAM is wrong at this size, because the embedder needs
# that memory more than the page cache does. Also set in postgresql.conf:
#
#     shared_buffers = 128MB
#     work_mem = 4MB
#     maintenance_work_mem = 64MB
#     max_connections = 20
#
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2

# ---- what to switch off -------------------------------------------------
# Redis is a second resident process for a cache the response middleware already
# provides in-process. On 4 GB it costs more than it returns.
REDIS_ENABLED=false

# Local OCR loads a second vision model. The cloud path is used instead, and
# ingestion is not running on this machine anyway.
OCR_BACKEND=nvidia

# ---- required ------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
RATE_LIMIT_ENABLED=true
# NVIDIA_API_KEY=
# JWT_SECRET_KEY=
# DATABASE_URL=postgresql://shiksha_app:...@localhost/shiksha_setu
# ALLOWED_ORIGINS=https://your.domain
